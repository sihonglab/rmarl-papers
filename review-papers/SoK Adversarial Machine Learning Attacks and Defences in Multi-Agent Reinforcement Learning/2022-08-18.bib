@incollection{zhu_lie_2020,
	address = {Cham},
	title = {Lie {Another} {Day}: {Demonstrating} {Bias} in a {Multi}-round {Cyber} {Deception} {Game} of {Questionable} {Veracity}},
	volume = {12513},
	isbn = {978-3-030-64792-6 978-3-030-64793-3},
	shorttitle = {Lie {Another} {Day}},
	url = {https://link.springer.com/10.1007/978-3-030-64793-3_5},
	abstract = {Prior work has explored the use of defensive cyber deception to manipulate the information available to attackers and to proactively lie on behalf of both real and decoy systems. Such approaches can provide advantages to defenders by delaying attacker forward progress and thereby decreasing or eliminating attacker payoffs. In this work, we expand previous work by incorporating new parameters relating to attacker costs and choices. The extended model includes attacker costs for probing a system to learn its declared type ({\textquotedblleft}real{\textquotedblright} or {\textquotedblleft}fake{\textquotedblright}) and allows an attacker to proactively choose to leave the game early by walking away. While these additional parameters represent extensions to our prior model, they are key to understanding attacker behavior when confronted with deceptive cyber defenses. We first present the extended model and an analysis of the expected rewards for rational players. We then present the behavior of an adaptive attacker in a Markov Decision Process (MDP) simulation. Lastly, we relate our analytic and empirical findings to cognitive bias effects and speculate on how the manipulation of game parameters may be used in future work to both estimate and trigger bias effects during defender-attacker interactions.},
	language = {en},
	urldate = {2022-08-03},
	booktitle = {Decision and {Game} {Theory} for {Security}},
	publisher = {Springer International Publishing},
	author = {Bilinski, Mark and diVita, Joe and Ferguson-Walter, Kimberly and Fugate, Sunny and Gabrys, Ryan and Mauger, Justin and Souza, Brian},
	editor = {Zhu, Quanyan and Baras, John S. and Poovendran, Radha and Chen, Juntao},
	year = {2020},
	doi = {10.1007/978-3-030-64793-3_5},
	note = {Series Title: Lecture Notes in Computer Science},
	pages = {80--100},
	file = {Bilinski et al. - 2020 - Lie Another Day Demonstrating Bias in a Multi-rou.pdf:C\:\\Users\\max\\Zotero\\storage\\39YQ5DZ6\\Bilinski et al. - 2020 - Lie Another Day Demonstrating Bias in a Multi-rou.pdf:application/pdf},
