	file = {Sun et al. - 2020 - Deep reinforcement learning for optical systems A.pdf:C\:\\Users\\max\\Zotero\\storage\\BLQNJUII\\Sun et al. - 2020 - Deep reinforcement learning for optical systems A.pdf:application/pdf},
}

@inproceedings{fazlyab_introduction_2021,
	title = {An {Introduction} to {Neural} {Network} {Analysis} via {Semidefinite} {Programming}},
	doi = {10.1109/CDC45484.2021.9683096},
	abstract = {Neural networks have become increasingly effective at many difficult machine learning tasks. However, the nonlinear and large-scale nature of neural networks makes them hard to analyze, and, therefore, they are mostly used as blackbox models without formal guarantees. This issue becomes even more complicated when neural networks are used in learning-enabled closed-loop systems, where a small perturbation can substantially impact the system being controlled. Therefore, it is of utmost importance to develop tools that can provide useful certificates of stability, safety, and robustness for neural network-driven systems.In this overview, we present a convex optimization framework for the analysis of neural networks. The main idea is to abstract hard-to-analyze components of a neural network (e.g., the nonlinear activation functions) with the formalism of quadratic constraints. This abstraction allows us to reason about various properties of neural networks (safety, robustness, generalization, stability in closed-loop settings, etc.) via semidefinite programming.},
	booktitle = {{IEEE} {Conference} on {Decision} and {Control}},
	author = {Fazlyab, Mahyar and Morari, Manfred and Pappas, George J.},
	month = dec,
	year = {2021},
	note = {ISSN: 2576-2370},
	keywords = {Neural networks, Robustness, Scalability, Convex functions, Robust control, Stability analysis, Tutorials},
	pages = {6341--6350},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\max\\Zotero\\storage\\G8RVRHAI\\9683096.html:text/html},
}

