@inproceedings{riveret_neuro-symbolic_2015,
	title = {Neuro-symbolic agents: {Boltzmann} machines and probabilistic abstract argumentation with sub-arguments},
	volume = {3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84944685397&partnerID=40&md5=0af3baf78d113b40ffa58597d0b95cc4},
	abstract = {Towards neuroargumentatiVe agents based on the seamless integration of neural networks and defeasible formalisms, with principled probabilistic settings and along efficient algorithms, we investigate argumentative Boltzmann machines where the possible states of a Boltzmann machine are constrained by a prior argumentative knowledge. To make our ideas as widely applicable as possible, and acknowledging the role of sub-arguments in probabilistic argumentation, we consider an abstract argumentation framework accounting for sub-arguments, but where the content of (sub-)arguments is left unspecified. We validate our proposal with artificial datasets and suggest its advantages. Copyright {\textcopyright} 2015, International Foundation for Autonomous Agents and Multiagent Systems (www.ifaamas.org). All rights reserved.},
