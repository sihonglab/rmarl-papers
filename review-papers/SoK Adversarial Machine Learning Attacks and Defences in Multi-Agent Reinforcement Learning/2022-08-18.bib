	pages = {90--109},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\max\\Zotero\\storage\\KF32CKTQ\\9536399.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\max\\Zotero\\storage\\LB7N4Z2S\\Ilahi et al. - 2021 - Challenges and Countermeasures for Adversarial Att.pdf:application/pdf;Submitted Version:C\:\\Users\\max\\Zotero\\storage\\5PP4N4MY\\Ilahi et al. - 2022 - Challenges and Countermeasures for Adversarial Att.pdf:application/pdf},
