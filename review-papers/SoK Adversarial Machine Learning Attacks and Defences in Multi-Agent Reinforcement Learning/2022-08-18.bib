	title = {Agent-{Mediated} {Electronic} {Commerce} and {Trading} {Agent} {Design} and {Analysis} - {AAMAS} {Workshop}, {AMEC} 2008, and {AAAI} {Workshop}, {TADA} 2008, {Revised} {Selected} {Papers}},
