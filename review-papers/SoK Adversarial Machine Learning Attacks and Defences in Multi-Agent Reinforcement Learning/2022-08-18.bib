@article{tuyls_multiagent_2012,
	title = {Multiagent {Learning}: {Basics}, {Challenges}, and {Prospects}},
	volume = {33},
	copyright = {Copyright (c)},
	issn = {2371-9621},
	shorttitle = {Multiagent {Learning}},
	url = {https://ojs.aaai.org/index.php/aimagazine/article/view/2426},
	doi = {10.1609/aimag.v33i3.2426},
	abstract = {Multiagent systems (MAS) are widely accepted as an important method for solving problems of a distributed nature. A key to the success of MAS is efficient and effective multiagent learning (MAL). The past twenty-five years have seen a great interest and tremendous progress in the field of MAL. This article introduces and overviews this field by presenting its fundamentals, sketching its historical development and describing some key algorithms for MAL. Moreover, main challenges that the field is facing today are indentified.},
