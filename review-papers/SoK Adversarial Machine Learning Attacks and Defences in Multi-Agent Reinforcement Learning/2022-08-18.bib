	keywords = {Reinforcement learning, Internet of Things, deep reinforcement learning, Conferences, Vehicular ad hoc networks, Delays, Dynamic scheduling, internet of vehicles, multi-access edge computing, service placement, Sybil attack, Trajectory},
	pages = {1--6},
