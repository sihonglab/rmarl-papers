	keywords = {Statistics - Machine Learning, Computer Science - Machine Learning, Computer Science - Artificial Intelligence, Computer Science - Computer Vision and Pattern Recognition, Computer Science - Robotics},
	file = {arXiv Fulltext PDF:C\:\\Users\\max\\Zotero\\storage\\8KAHJ3XD\\OpenAI et al. - 2019 - Solving Rubik's Cube with a Robot Hand.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\max\\Zotero\\storage\\PA39LUJR\\1910.html:text/html},
